NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Supabase project settings: Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Postgres connection string: Project Settings -> Database -> Connection string
# Prefer the Session pooler string, especially if direct connections are unavailable.
# Direct db.<ref>.supabase.co connections are IPv6-only on many Supabase projects.
# Supabase requires SSL.
# If the database password contains URL-special characters such as ? # @ / or :,
# percent-encode them first. For example, p?ss becomes p%3Fss.
DATABASE_URL=postgresql://postgres.your-project-ref:your-database-password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
